# Root-level environment variables for the local docker-compose stack.
# Copy this file to .env and fill in each value before running `yarn docker:up`.
#
#   cp .env.example .env
#
# .env is listed in .gitignore and must never be committed.
# This file (.env.example) is safe to commit — it contains no real secrets.

# ---------------------------------------------------------------------------
# Hasura GraphQL Engine — admin secret
# ---------------------------------------------------------------------------
# Required. Used by both the Hasura service and the backend service in
# docker-compose.yml.  Choose any strong, random string (e.g. from
# `openssl rand -hex 32`).  Do NOT use the old placeholder
# "safetrust_admin_secret_2024" — it is publicly known and insecure.
#
HASURA_GRAPHQL_ADMIN_SECRET=change-me-to-a-strong-random-secret

# ---------------------------------------------------------------------------
# Backend service — Firebase Admin SDK (required)
# ---------------------------------------------------------------------------
# Firebase console → Project settings → Service accounts → Generate new key.
# Keep the private key on one line with literal \n separators and quoted.
# Without these `docker-compose up` refuses to start the backend service.
#
FIREBASE_ADMIN_PROJECT_ID=your-firebase-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# ---------------------------------------------------------------------------
# Backend service — optional
# ---------------------------------------------------------------------------
# Leave blank to disable the feature; the backend treats empty values as unset.
# DATABASE_URL and HASURA_GRAPHQL_URL are wired to the in-network postgres and
# hasura services by docker-compose.yml and don't need to be set here.
#
# CORS_ORIGINS=http://localhost:3000
# LOG_LEVEL=info
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=100
#
# Trustless Work / Stellar — refunds, dispute resolution, escrow webhooks
# TRUSTLESS_WORK_API_URL=https://dev.api.trustlesswork.com
# TRUSTLESS_WORK_API_KEY=
# TRUSTLESS_WORK_DISPUTE_RESOLVER_SECRET=
# TRUSTLESS_WORK_WEBHOOK_SECRET=
# STELLAR_NETWORK=testnet
#
# Observability
# SENTRY_DSN=
# CRITICAL_ALERT_WEBHOOK_URL=
#
# Notifications
# EMAIL_PROVIDER=
# SENDGRID_API_KEY=
# NOTIFICATION_FROM_EMAIL=noreply@truestub.local
