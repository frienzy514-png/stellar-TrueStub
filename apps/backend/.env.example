# Server port (default: 4000)
PORT=4000

# Environment mode: development | production | test (default: development)
NODE_ENV=development

# Firebase Admin SDK — see Firebase console → Project settings → Service accounts
FIREBASE_ADMIN_PROJECT_ID=your-firebase-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# HMAC secret Trustless Work signs escrow-status webhooks with. Required for
# POST /webhooks/escrow-status — without it the route rejects every delivery.
# TRUSTLESS_WORK_WEBHOOK_SECRET=

# Optional defense-in-depth source-IP allowlist for POST /webhooks/escrow-status
# (#532): comma-separated IPv4/IPv6 addresses or CIDR ranges matched against
# the immediate peer (req.ip). Unset = HMAC only (the default). Trustless Work
# does not publish stable webhook IPs, so only set this for known peers such as
# the frontend pass-through server or your ingress. See SECURITY.md.
# TRUSTLESS_WORK_WEBHOOK_ALLOWED_IPS=

# Hasura — used by the escrow-status webhook and sync-user to write data.
# HASURA_GRAPHQL_URL=
# HASURA_GRAPHQL_ADMIN_SECRET=

# Postgres connection used by `yarn migrate:up` (node-pg-migrate) and by the
# backend's direct Postgres access. Matches the root docker-compose.yml
# Postgres service.
DATABASE_URL=postgres://postgres:postgrespassword@localhost:5432/safetrust

# Postgres pool/timeout tuning (#412). Pooling behavior is explicitly
# configured rather than left to driver defaults; defaults shown.
# PG_POOL_MAX=10
# PG_IDLE_TIMEOUT_MS=30000
# PG_CONNECTION_TIMEOUT_MS=5000
# PG_QUERY_TIMEOUT_MS=10000

# Trustless Work — required to execute refunds on-chain (POST /api/refunds/claim).
# TRUSTLESS_WORK_API_URL defaults to https://dev.api.trustlesswork.com (testnet);
# use https://api.trustlesswork.com with STELLAR_NETWORK=mainnet in production.
# TRUSTLESS_WORK_DISPUTE_RESOLVER_SECRET is the secret key (S...) of the
# platform's dispute-resolver wallet (NEXT_PUBLIC_DISPUTE_RESOLVER_ADDRESS in
# the frontend). Never commit a real value.
# Safety guard (#415): unless NODE_ENV=production (and CI is unset), refund
# submission is refused with 503 REFUND_MAINNET_SUBMISSION_BLOCKED whenever
# STELLAR_NETWORK=mainnet or TRUSTLESS_WORK_API_URL is the mainnet host.
# TRUSTLESS_WORK_API_URL=https://dev.api.trustlesswork.com
# TRUSTLESS_WORK_API_KEY=
# TRUSTLESS_WORK_DISPUTE_RESOLVER_SECRET=
# STELLAR_NETWORK=testnet

# Network the frontend is configured for (NEXT_PUBLIC_TRUSTLESS_NETWORK).
# The backend cross-checks this against STELLAR_NETWORK at startup (#414) and
# refuses to boot on a mismatch, so a frontend/backend network divergence is
# caught automatically instead of in production.
# FRONTEND_TRUSTLESS_NETWORK=testnet

# Sentry error tracking — https://docs.sentry.io/platforms/javascript/guides/express/
# Leave blank to disable Sentry (no-op).
SENTRY_DSN=

# Dedicated alert channel for refund/transfer failures (#328). When unset,
# alerts are only logged and sent to Sentry.
# CRITICAL_ALERT_WEBHOOK_URL=

# Optional tuning — defaults shown.
# CORS_ORIGINS=http://localhost:3000
# LOG_LEVEL=info
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=100
