# Server port (default: 4000)
PORT=4000

# Environment mode: development | production | test (default: development)
NODE_ENV=development

# Firebase Admin SDK — see Firebase console → Project settings → Service accounts
FIREBASE_ADMIN_PROJECT_ID=your-firebase-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# HMAC secret Trustless Work signs escrow-status webhooks with. Required for
# POST /webhooks/escrow-status — without it the route rejects every delivery.
# TRUSTLESS_WORK_WEBHOOK_SECRET=

# Hasura — used by the escrow-status webhook and sync-user to write data.
# HASURA_GRAPHQL_URL=
# HASURA_GRAPHQL_ADMIN_SECRET=

# Postgres connection used by `yarn migrate:up` (node-pg-migrate).
# Matches the root docker-compose.yml Postgres service.
DATABASE_URL=postgres://postgres:postgrespassword@localhost:5432/safetrust

# Trustless Work — required to execute refunds on-chain (POST /api/refunds/claim).
# TRUSTLESS_WORK_API_URL defaults to https://dev.api.trustlesswork.com (testnet);
# use https://api.trustlesswork.com with STELLAR_NETWORK=mainnet in production.
# TRUSTLESS_WORK_DISPUTE_RESOLVER_SECRET is the secret key (S...) of the
# platform's dispute-resolver wallet (NEXT_PUBLIC_DISPUTE_RESOLVER_ADDRESS in
# the frontend). Never commit a real value.
# TRUSTLESS_WORK_API_URL=https://dev.api.trustlesswork.com
# TRUSTLESS_WORK_API_KEY=
# TRUSTLESS_WORK_DISPUTE_RESOLVER_SECRET=
# STELLAR_NETWORK=testnet

# Sentry error tracking — https://docs.sentry.io/platforms/javascript/guides/express/
# Leave blank to disable Sentry (no-op).
SENTRY_DSN=
