# Server port (default: 4000)
PORT=4000

# Environment mode: development | production | test (default: development)
NODE_ENV=development

# Firebase Admin SDK — see Firebase console → Project settings → Service accounts
FIREBASE_ADMIN_PROJECT_ID=your-firebase-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# --- Roadmap / Future Route Migration Variables ---
# The following variables will be required as corresponding routes migrate from apps/frontend (see apps/backend/README.md)
# TRUSTLESS_WORK_WEBHOOK_SECRET=
# HASURA_GRAPHQL_URL=
# HASURA_GRAPHQL_ADMIN_SECRET=

# Sentry error tracking — https://docs.sentry.io/platforms/javascript/guides/express/
# Leave blank to disable Sentry (no-op).
SENTRY_DSN=
