# Firebase Client SDK — see README section 1 for where to find these
NEXT_PUBLIC_FIREBASE_API_KEY=<your apiKey>
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=<your-project-id>.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=<your-project-id>
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=<your-project-id>.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=<your messagingSenderId>
NEXT_PUBLIC_FIREBASE_APP_ID=<your appId>

# Hasura GraphQL — see README section 3
NEXT_PUBLIC_HASURA_GRAPHQL_URL=<your-hasura-instance>/v1/graphql

# NEVER set NEXT_PUBLIC_HASURA_ADMIN_SECRET (or any admin secret) here.
# The admin secret belongs only in the backend's server-side environment.
# See README for why.

# apps/backend base URL, for server-to-server calls (e.g. updating escrow
# status via /internal/escrow-status — see src/lib/server/hasura.ts).
BACKEND_URL=http://localhost:4000

# Shared secret sent on those server-to-server calls. Must match
# INTERNAL_API_SECRET in apps/backend's environment.
INTERNAL_API_SECRET=<a-long-random-shared-secret>

# HMAC secret Trustless Work signs webhook payloads with — see
# src/app/webhooks/escrow-status/route.ts.
TRUSTLESS_WORK_WEBHOOK_SECRET=<your-trustless-work-webhook-secret>

# Trustless Work API — see README section 4 and src/core/config/axios/http.ts
# NEXT_PUBLIC_API_KEY is the bearer token used by both the axios http client
# and the TrustlessWork SDK provider.  Never hard-code this in source files.
NEXT_PUBLIC_API_KEY=<your-trustless-work-api-key>
# Mainnet / production API base URL.
NEXT_PUBLIC_TRUSTLESS_API_URL=https://api.trustlesswork.com
# Testnet / dev API base URL — used automatically when NODE_ENV=development.
NEXT_PUBLIC_TRUSTLESS_API_URL_DEV=https://dev.api.trustlesswork.com
# Network passphrase selector: "testnet" or "mainnet"
NEXT_PUBLIC_TRUSTLESS_NETWORK=testnet

# Sentry error tracking — see https://docs.sentry.io/platforms/javascript/guides/nextjs/
# Set NEXT_PUBLIC_SENTRY_DSN to your Sentry project DSN; leave blank to disable Sentry.
NEXT_PUBLIC_SENTRY_DSN=
# Human-readable environment label sent to Sentry (defaults to NODE_ENV if unset).
NEXT_PUBLIC_SENTRY_ENVIRONMENT=

# Build-time Sentry source-map upload (only needed in CI / release pipelines).
# Store these in your CI secrets, never in a committed .env file.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=